# Local development settings for compose.yaml (PostgreSQL). Development only: never reuse these values elsewhere.
# Copy to .env (git-ignored) and fill in a password. docker compose reads .env from this directory.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<choose-a-local-password>
POSTGRES_DB=ReactDotnetBoilerplateDb
# Host port, bound to 127.0.0.1. Change it if 5432 is taken (for example by a locally installed PostgreSQL).
POSTGRES_PORT=5432

# The API reads ConnectionStrings:DefaultConnection from server/ReactDotnetBoilerplate.Api/appsettings.json.
# If you change any value above, update that connection string, or uncomment this override. It is applied by the
# "Backend: API (settings from .env)" VS Code launch configuration; for `dotnet run`, set it in your shell.
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=ReactDotnetBoilerplateDb;Username=postgres;Password=<choose-a-local-password>
