# Local development settings for compose.yaml (optional SQL Server container). Development only.
# Copy to .env (git-ignored) and fill in the values. docker compose reads .env from this directory.

# Set to Y to accept the SQL Server license terms (https://hub.docker.com/r/microsoft/mssql-server).
MSSQL_ACCEPT_EULA=
# At least 8 characters from three of: upper case, lower case, digits, symbols.
MSSQL_SA_PASSWORD=<choose-a-strong-local-password>
# Host port, bound to 127.0.0.1. Change it if 1433 is taken.
MSSQL_PORT=1433

# The API's default connection string (appsettings.json) uses LocalDB. To use the container instead, uncomment this
# override. It is applied by the "Backend: API (settings from .env)" VS Code launch configuration; for `dotnet run`,
# set it in your shell.
# ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=ReactDotnetBoilerplateDb;User Id=sa;Password=<choose-a-strong-local-password>;TrustServerCertificate=True;MultipleActiveResultSets=true
