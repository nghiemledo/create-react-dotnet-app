# NEXT_PUBLIC_* values are inlined into the browser bundle at build time (next dev / next build).
# Never put secrets here. Restart `next dev` or rebuild after changing them.
NEXT_PUBLIC_APP_NAME=Hệ thống quản lý đào tạo
# The URL the *browser* uses to reach the ASP.NET Core API (launchSettings https profile).
# Use a host-reachable address, never a Docker Compose service name.
NEXT_PUBLIC_API_BASE_URL=https://localhost:7001
NEXT_PUBLIC_API_TIMEOUT=15000
